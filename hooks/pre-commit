#!/bin/sh
# Rebuild, verify, then regenerate README previews from the staged snapshot.
set -e
root=$(git rev-parse --show-toplevel)
cd "$root"
if git diff --cached --name-only | grep -qE '^(ui-library/|scripts/|assets/|hooks/|SKILL\.md)'; then
  if git status --porcelain --untracked-files=all -- ui-library scripts assets hooks SKILL.md | grep -qE '^(\?\?|.[^ ])'; then
    echo "Stage every library, script, asset, hook, and SKILL.md change first; the hook rebuilds the staged snapshot." >&2
    exit 1
  fi
  node ui-library/build.mjs >/dev/null
  node ui-library/verify.mjs >/dev/null
  node scripts/selftest.mjs >/dev/null
  node scripts/layout-check.mjs >/dev/null
  node scripts/previews.mjs >/dev/null
  git add \
    ui-library/reply-template.html \
    ui-library/complete-template.html \
    ui-library/index.html \
    ui-library/ELEMENT_INDEX.md \
    ui-library/README.md \
    ui-library/snippets \
    ui-library/logic \
    screenshots/overview.png \
    screenshots/reply-mobile.png \
    screenshots/gallery.png
fi

